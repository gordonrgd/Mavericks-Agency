# ============================================
# Mavericks Agency - Variables d'environnement
# ============================================
# Copiez en .env.local : cp .env.example .env.local
#
# ───────────────────────────────────────────
# E-mail : domaine chez Cloudflare + Proton
# ───────────────────────────────────────────
#
# Ce que tu as en général :
#   • Nom de domaine + DNS sur Cloudflare
#   • Adresse du type contact@tondomaine.com qui REDIRIGE vers une boîte Proton
#     (Cloudflare Email Routing : MX Cloudflare → forward vers user@proton.me)
#
# Important : cette redirection sert à RECEVOIR les e-mails qui arrivent sur ton domaine.
# Le site, lui, doit ENVOYER les formulaires via une vraie API d’envoi ou SMTP :
#   • soit Resend (recommandé : tu ajoutes des enregistrements DNS chez Cloudflare) ;
#   • soit le SMTP Proton avec un mot de passe SMTP dédié sur ton compte Proton.
#
# Destinataire des notifications (apply + contact) :
#   • contact@tondomaine.com si Cloudflare reçoit bien pour cette adresse et forward vers Proton ;
#   • ou directement ton user@proton.me (plus simple, toujours fiable).
#

# --- Option A — Resend (recommandé avec domaine sur Cloudflare) ---
# 1) Compte sur https://resend.com → Domaines → ajouter mavericks-agency.com
# 2) Copier les enregistrements DNS (SPF, etc.) dans Cloudflare
# 3) Clé API + expéditeur = une adresse du domaine vérifié
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM=contact@mavericks-agency.com
# SMTP_TO=contact@mavericks-agency.com
#   (ou SMTP_TO=ton-adresse@proton.me)

# --- Option B — SMTP Proton (compte Proton avec SMTP activé) ---
# Proton : Paramètres → IMAP/SMTP → activer SMTP → mot de passe pour cette application
# SMTP_HOST=smtp.protonmail.ch
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=ton-compte@proton.me
# SMTP_PASSWORD=mot_de_passe_smtp_proton
# En général l’expéditeur doit correspondre au compte ou à un alias Proton autorisé :
# SMTP_FROM=ton-compte@proton.me
# SMTP_TO=contact@mavericks-agency.com
#   (ou ton user@proton.me)

# Alternative à SMTP_TO si tu la laisses vide (ordre dans le code : SMTP_TO puis ceci) :
# NOTIFICATION_EMAIL=contact@mavericks-agency.com

# ============================================
# Site
# ============================================
# URL canonique (sans slash final). OG, images absolues, fallback meta.
# Production : https://www.mavericks-agency.com (aligné avec le domaine Vercel)
# NEXT_PUBLIC_SITE_URL=https://www.mavericks-agency.com
#
# Cloudflare Turnstile (optionnel) — anti-spam sur /contact et candidature.
# Si TURNSTILE_SECRET_KEY est défini, l’API exige un jeton valide.
# Création des clés : Cloudflare Dashboard → Turnstile.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...
# TURNSTILE_SECRET_KEY=0x4AAAAAAA...
#
# Vercel Web Analytics : activer dans le projet Vercel (onglet Analytics) ;
# le composant <Analytics /> est déjà dans app/layout.tsx — aucune variable requise.
#
# Meta Pixel (Facebook) — Events Manager → ID du pixel
# NEXT_PUBLIC_META_PIXEL_ID=974367795430177
# NODE_ENV=production
