# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
pnpm-lock.yaml

# next.js
/.next/
/out/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (secrets — never commit; keep example for the repo)
.env*
!.env.example

# OS / backups (do not push to GitHub)
.DS_Store
mavericks.zip

# accidental artifact (e.g. mistaken scp / terminal paste)
root@*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts